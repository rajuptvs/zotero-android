<?xml version="1.0" encoding="utf-8"?>
<!-- ChatGPT credentials are encrypted with a device-bound Keystore key and the host ID must be
     unique per device, so neither may be restored onto another device. Semantic search is turned
     on per device (its model download isn't backed up). -->
<full-backup-content>
    <exclude domain="sharedpref" path="ChatGptAuth.xml" />
    <exclude domain="sharedpref" path="ai_semantic.xml" />
</full-backup-content>
